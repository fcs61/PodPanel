<Window x:Class="PodPanel.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PodPanel"
        Title="PodPanel" Width="344" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:StringToVisibilityConverter x:Key="TextToVis" />

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Bölüm etiketi: küçük, soluk -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Yuvarlak kenarlı düğme -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="14" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bölmeli seçici düğmesi; Tag seçili olduğunu bildirir -->
        <Style x:Key="Segment" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="Transparent" Padding="7,7">
                            <!-- Uzun çevirilerde metin kırpılmaz, sığacak kadar küçülür (yalnızca küçülür, büyümez). -->
                            <Viewbox StretchDirection="DownOnly" Stretch="Uniform">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Seçici zemini -->
        <Style x:Key="SegmentTrack" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <!-- Büyük aç/kapa kutusu: simge ve tek sözcük; açıkken vurgu rengi. Tag simgeyi taşır. -->
        <Style x:Key="Tile" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="62" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                                           HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                <Viewbox StretchDirection="DownOnly" Stretch="Uniform" Margin="5,6,5,0" MaxHeight="18">
                                    <ContentPresenter HorizontalAlignment="Center" />
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metin bağlantısı -->
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Satır biçiminde seçilebilir öğe -->
        <Style x:Key="Row" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="4,3">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{DynamicResource SubTextBrush}" Background="Transparent" VerticalAlignment="Top">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ses çubuğu: ince iz, vurgu renginde dolu kısım, yuvarlak tutamak -->
        <Style x:Key="VolumeTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="18">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Volume" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="18">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource VolumeTrackButton}" Command="Slider.DecreaseLarge"
                                              Background="{DynamicResource AccentBrush}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource VolumeTrackButton}" Command="Slider.IncreaseLarge"
                                              Background="{DynamicResource HoverBrush}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource BgBrush}" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <!-- Gölge ayrı katmanda: içerik metni bulanıklaşmasın -->
        <Border CornerRadius="12" Background="{DynamicResource BgBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="12" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
            <StackPanel Margin="16,16,16,10">

                <!-- Başlık: ad, tek satır durum, bağlı değilken "Bağlan" -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Pill}" Content="{local:T connect}" Command="{Binding ToggleConnectionCommand}"
                            VerticalAlignment="Center" Margin="8,0,0,0"
                            Visibility="{Binding ShowConnect, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- Pil -->
                <Grid Margin="0,14,0,0" Background="Transparent" ToolTip="{Binding BatteryTip}"
                      Visibility="{Binding IsFound, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{local:T left}" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                            <TextBlock Text="{Binding BatteryLeftText}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="11" Margin="3,2,0,0" Foreground="{DynamicResource OkBrush}"
                                       Visibility="{Binding IsChargingLeft, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:T right}" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                            <TextBlock Text="{Binding BatteryRightText}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="11" Margin="3,2,0,0" Foreground="{DynamicResource OkBrush}"
                                       Visibility="{Binding IsChargingRight, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{local:T case}" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                            <TextBlock Text="{Binding BatteryCaseText}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="11" Margin="3,2,0,0" Foreground="{DynamicResource OkBrush}"
                                       Visibility="{Binding IsChargingCase, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Tek satırlık uyarı: yalnızca bir sorun varken -->
                <Border CornerRadius="8" Background="{DynamicResource CardBrush}" Padding="10,7" Margin="0,12,0,0"
                        ToolTip="{Binding BannerTip}"
                        Visibility="{Binding BannerText, Converter={StaticResource TextToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding BannerText}" Foreground="{DynamicResource WarnBrush}" FontSize="12" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource Link}" Content="{Binding BannerAction}" Command="{Binding BannerCommand}"
                                Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding BannerAction, Converter={StaticResource TextToVis}}" />
                    </Grid>
                </Border>

                <!-- Dinleme modu -->
                <Border Style="{StaticResource SegmentTrack}" Margin="0,14,0,0"
                        Visibility="{Binding ShowModes, Converter={StaticResource BoolToVis}}"
                        ToolTip="{local:T tip_modes}">
                    <local:ShareRow IsEnabled="{Binding ModesEnabled}">
                        <Button Style="{StaticResource Segment}" Content="{local:T mode_transparency}" Tag="{Binding IsModeTransparency}"
                                Command="{Binding SetModeCommand}" CommandParameter="transparency" />
                        <Button Style="{StaticResource Segment}" Content="{local:T mode_adaptive}" Tag="{Binding IsModeAdaptive}"
                                Command="{Binding SetModeCommand}" CommandParameter="adaptive" />
                        <Button Style="{StaticResource Segment}" Content="{local:T mode_nc}" Tag="{Binding IsModeNoiseCancellation}"
                                Command="{Binding SetModeCommand}" CommandParameter="nc" />
                    </local:ShareRow>
                </Border>

                <!-- Gecikme -->
                <Grid Margin="0,8,0,0" Visibility="{Binding ShowModes, Converter={StaticResource BoolToVis}}"
                      ToolTip="{local:T tip_latency}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{local:T latency}" Style="{StaticResource Label}" Margin="2,0,12,0" />
                    <Border Grid.Column="1" Style="{StaticResource SegmentTrack}">
                        <UniformGrid Rows="1">
                            <Button Style="{StaticResource Segment}" Content="150" Tag="{Binding IsJitterDefault}"
                                    Command="{Binding SetJitterCommand}" CommandParameter="0" />
                            <Button Style="{StaticResource Segment}" Content="90" Tag="{Binding IsJitter90}"
                                    Command="{Binding SetJitterCommand}" CommandParameter="90" />
                            <Button Style="{StaticResource Segment}" Content="60" Tag="{Binding IsJitter60}"
                                    Command="{Binding SetJitterCommand}" CommandParameter="60" />
                        </UniformGrid>
                    </Border>
                </Grid>

                <!-- Aç/kapa kutuları -->
                <UniformGrid Rows="1" Margin="-3,12,-3,0" Visibility="{Binding IsFound, Converter={StaticResource BoolToVis}}">
                    <ToggleButton Style="{StaticResource Tile}" Tag="&#xE720;" Content="{local:T mic}" IsChecked="{Binding BridgeMic, Mode=TwoWay}"
                                  Visibility="{Binding ShowBridgeMic, Converter={StaticResource BoolToVis}}"
                                  ToolTip="{local:T tip_mic}" />
                    <ToggleButton Style="{StaticResource Tile}" Tag="&#xE7F5;" Content="{local:T spatial}" IsChecked="{Binding SpatialOn, Mode=TwoWay}"
                                  IsEnabled="{Binding SpatialEnabled}"
                                  ToolTip="{Binding SpatialTip}" ToolTipService.ShowOnDisabled="True" />
                    <ToggleButton Tag="&#xE7FC;" Content="{local:T game_mode}" IsChecked="{Binding GameMode, Mode=TwoWay}" ToolTip="{Binding GameTip}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource Tile}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GameModeAuto}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </UniformGrid>

                <!-- Ses düzeyi: Windows'un ses çubuğuyla aynı değer -->
                <Grid Margin="0,12,0,0" Visibility="{Binding ShowVolume, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Link}" Command="{Binding ToggleMuteCommand}" ToolTip="{Binding MuteTip}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding VolumeGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Margin="2,0,10,0" />
                    </Button>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource Volume}" Minimum="0" Maximum="100"
                            Value="{Binding Volume, Mode=TwoWay}" SmallChange="2" LargeChange="10" IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" ToolTip="{local:T volume}" />
                    <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Style="{StaticResource Value}" MinWidth="26"
                               TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>

                <!-- Alt satır -->
                <Grid Margin="0,12,0,0">
                    <Button Style="{StaticResource Link}" Command="{Binding ToggleDetailsCommand}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{local:T settings}" />
                            <TextBlock Text="{Binding DetailsGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Margin="6,3,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Link}" Content="{local:T exit}" Command="{Binding ExitCommand}" HorizontalAlignment="Right" />
                </Grid>

                <!-- Ayarlar: kapalı gelir -->
                <StackPanel Margin="0,8,0,4" Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{local:T audio}" Style="{StaticResource Label}" Margin="0,2" />
                        <TextBlock Grid.Column="1" Text="{Binding AudioModeText}" Style="{StaticResource Value}" Margin="0,2" />
                        <TextBlock Grid.Row="1" Text="{local:T latency}" Style="{StaticResource Label}" Margin="0,2" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DelayText}" Style="{StaticResource Value}" Margin="0,2" />
                        <TextBlock Grid.Row="2" Text="{local:T mic}" Style="{StaticResource Label}" Margin="0,2" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MicText}" Style="{StaticResource Value}" Margin="0,2" />
                        <TextBlock Grid.Row="3" Text="{local:T spatial}" Style="{StaticResource Label}" Margin="0,2" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SpatialText}" Style="{StaticResource Value}" Margin="0,2" />
                    </Grid>
                    <TextBlock Text="{Binding LinkNote}" Foreground="{DynamicResource WarnBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding LinkNote, Converter={StaticResource TextToVis}}" />

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasMics, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{local:T game_mic}" Style="{StaticResource Label}" Margin="0,0,0,2" />
                        <ItemsControl ItemsSource="{Binding Mics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Row}"
                                            Command="{Binding DataContext.SelectMicCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1" />
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                                         Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <CheckBox Style="{StaticResource Check}" Content="{local:T lock_mic}" IsChecked="{Binding LockMic, Mode=TwoWay}"
                              Margin="0,10,0,0" ToolTip="{local:T tip_lock_mic}" />
                    <CheckBox Style="{StaticResource Check}" Content="{local:T auto_game}" IsChecked="{Binding AutoGame, Mode=TwoWay}"
                              Margin="0,8,0,0" ToolTip="{local:T tip_auto_game}" />
                    <StackPanel Margin="24,4,0,0">
                        <!-- Eklenmiş oyunlar: ad ve çıkarma düğmesi -->
                        <ItemsControl ItemsSource="{Binding Games}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTip="{Binding Exe}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Value}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Style="{StaticResource Link}" ToolTip="{local:T remove_from_list}"
                                                Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Name}">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                       Margin="10,3,4,3" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{local:T no_games}" Style="{StaticResource Muted}" Margin="0,2"
                                   Visibility="{Binding NoGames, Converter={StaticResource BoolToVis}}" />

                        <Button Style="{StaticResource Link}" Command="{Binding TogglePickerCommand}" HorizontalAlignment="Left"
                                Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"
                                ToolTip="{local:T tip_add_game}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="0,3,6,0" />
                                <TextBlock Text="{local:T add_game}" />
                            </StackPanel>
                        </Button>

                        <!-- Seçici: penceresi açık uygulamalar, en son kullanılan başta -->
                        <Border CornerRadius="8" Background="{DynamicResource CardBrush}" Padding="6,6,6,5" Margin="0,5,0,0"
                                Visibility="{Binding ShowPicker, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{local:T open_apps}" Style="{StaticResource Label}" Margin="4,0,0,3" />
                                <ItemsControl ItemsSource="{Binding OpenApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Row}"
                                                    Command="{Binding DataContext.AddGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                                    <TextBlock Text="{Binding Exe}" Style="{StaticResource Muted}" FontSize="11" Margin="8,1,0,0"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="90" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{local:T open_game_first}" Style="{StaticResource Muted}" Margin="4,0,4,2" TextWrapping="Wrap"
                                           Visibility="{Binding PickerEmpty, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <CheckBox Style="{StaticResource Check}" Content="{local:T auto_pause}"
                              IsChecked="{Binding AutoPause, Mode=TwoWay}" Margin="0,10,0,0"
                              Visibility="{Binding ShowBridgeMic, Converter={StaticResource BoolToVis}}"
                              ToolTip="{local:T tip_auto_pause}" />
                    <CheckBox Style="{StaticResource Check}" Content="{local:T start_with_windows}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              Margin="0,10,0,0" />
                    <Button Style="{StaticResource Link}" Command="{Binding ToggleLanguagesCommand}" HorizontalAlignment="Left"
                            Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF2B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,2,7,0" />
                            <TextBlock Text="{Binding LanguageLabel}" />
                            <TextBlock Text="{Binding LanguagesGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                       Margin="6,3,0,0" />
                        </StackPanel>
                    </Button>
                    <Border CornerRadius="8" Background="{DynamicResource CardBrush}" Padding="6" Margin="0,5,0,0"
                            Visibility="{Binding ShowLanguages, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Languages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Row}"
                                            Command="{Binding DataContext.SelectLanguageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Code}">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1" />
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                                         Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Button Style="{StaticResource Link}" Content="{local:T disconnect}" Command="{Binding ToggleConnectionCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
