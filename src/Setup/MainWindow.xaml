<Window x:Class="PodPanel.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PodPanel Kurulumu" Width="540" Height="550" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="White"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0A63D6" />
        <SolidColorBrush x:Key="AccentHover" Color="#0854B8" />
        <SolidColorBrush x:Key="Text" Color="#1B1B1B" />
        <SolidColorBrush x:Key="Muted" Color="#5E5E5E" />
        <SolidColorBrush x:Key="Line" Color="#E3E3E3" />
        <SolidColorBrush x:Key="Warn" Color="#9A5B00" />
        <SolidColorBrush x:Key="Bad" Color="#C42B1C" />
        <SolidColorBrush x:Key="Good" Color="#0F7B0F" />

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#C8C8C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Secondary" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="#C8C8C8" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F0F0F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#A0A0A0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Orientation="Horizontal" Margin="28,24,28,18">
            <Image Source="podpanel.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitle" Text="PodPanel" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                <TextBlock x:Name="HeaderSub" Text="AirPods için görev çubuğu paneli" Foreground="{StaticResource Muted}" Margin="0,1,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 1. Hazırlık: ne yapılacağı ve denetim sonuçları -->
        <StackPanel x:Name="ReadyPage" Grid.Row="1" Margin="28,0,28,0">
            <TextBlock x:Name="ReadyIntro" TextWrapping="Wrap" Foreground="{StaticResource Text}" LineHeight="19" />
            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="ReadyWait" Text="Bilgisayar denetleniyor…" Foreground="{StaticResource Muted}" />
                    <ItemsControl x:Name="FindingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="#5E5E5E" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#1B1B1B" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ReadyProblems" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
            <CheckBox x:Name="OptionBox" Margin="0,14,0,0" IsChecked="True" Foreground="{StaticResource Text}" />
            <TextBlock x:Name="ReadyNote" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
        </StackPanel>

        <!-- 2. İlerleme -->
        <Grid x:Name="RunPage" Grid.Row="1" Margin="28,0,28,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ItemsControl x:Name="StepList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Width="24" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Text}" Foreground="{Binding TextBrush}" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ProgressBar x:Name="Progress" Grid.Row="1" Height="4" Margin="0,12,0,0" Minimum="0" Maximum="1" Foreground="{StaticResource Accent}"
                         Background="#EDEDED" BorderThickness="0" />
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLine" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button x:Name="DetailsButton" Grid.Column="1" Style="{StaticResource LinkButton}" Content="Ayrıntılar" FontSize="12" Margin="12,0,0,0"
                        Click="OnToggleDetails" />
            </Grid>
            <TextBox x:Name="LogBox" Grid.Row="3" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" BorderBrush="{StaticResource Line}" Visibility="Collapsed" />
        </Grid>

        <!-- 3. Sonuç -->
        <StackPanel x:Name="DonePage" Grid.Row="1" Margin="28,6,28,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="DoneGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" VerticalAlignment="Center" />
                <TextBlock x:Name="DoneTitle" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="DoneText" TextWrapping="Wrap" Foreground="{StaticResource Text}" Margin="0,14,0,0" LineHeight="19" />
            <TextBlock x:Name="DoneNote" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0" LineHeight="18" />
        </StackPanel>

        <!-- Düğmeler -->
        <Border Grid.Row="2" Background="#F6F6F6" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,14">
            <Grid>
                <Button x:Name="LogButton" Style="{StaticResource LinkButton}" Content="Günlüğü aç" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Visibility="Collapsed" Click="OnOpenLog" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton" Style="{StaticResource Secondary}" Content="Vazgeç" Click="OnSecondary" />
                    <Button x:Name="PrimaryButton" Style="{StaticResource Primary}" Content="Kur" Margin="10,0,0,0" IsEnabled="False" Click="OnPrimary" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
