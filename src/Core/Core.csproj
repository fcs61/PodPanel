<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>PodPanel.Core</AssemblyName>
    <RootNamespace>PodPanel.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Arayüz dilleri: her dosya "dil.<kod>.txt" adıyla derlemeye gömülür (bkz. Loc.cs). -->
    <EmbeddedResource Include="Diller\*.txt" LogicalName="dil.%(Filename).txt" />
  </ItemGroup>
</Project>
